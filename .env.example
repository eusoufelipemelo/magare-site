# Nenhuma variável é obrigatória: o site se conecta ao OutBox CMS pelo próprio domínio
# (campo `url` em src/site.config.ts). Basta o domínio estar cadastrado no CMS.

# Opcional: domínio de produção, se preferir não fixar no site.config.ts
SITE_URL=

# Opcional: outro endereço do CMS
OUTBOX_API_URL=https://cms.outboxgroup.com.br/api/v1

# Opcional (integrações antigas): chave pública e segredo do webhook
OUTBOX_SITE_KEY=
OUTBOX_WEBHOOK_SECRET=
